{
  "name": "feedlane",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, route-driven content feed conversion service.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "route:new": "node scripts/create-route.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:smoke": "node scripts/smoke-build.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm run test && pnpm run build && pnpm run build:smoke"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "cheerio": "1.2.0",
    "defuddle": "0.19.2",
    "feed": "6.0.0",
    "hono": "4.12.32",
    "linkedom": "0.18.13",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/sanitize-html": "2.16.1",
    "fast-xml-parser": "5.10.1",
    "msw": "2.15.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vercel": "58.4.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.18.0"
}
